# Copy this file to .env for local dev (server/.env). Render: set these as
# real environment variables in the dashboard instead — no .env file needed there.

# Absolute path to a persistent Render Disk mount (e.g. /var/data) — this is
# where the SQLite database lives. Render's web services have an ephemeral
# filesystem otherwise: every redeploy wipes anything written to disk,
# including every user account and session. Required in production; leave
# unset for local dev, where a throwaway db next to the code is fine.
DATA_DIR=

# Resend API key (https://resend.com). If unset, verification links are
# printed to the server console instead of emailed — fine for local testing.
RESEND_API_KEY=

# Sender shown on verification emails. The default onboarding@resend.dev works
# without verifying a domain, but Resend restricts it to sending only to the
# email on your own Resend account until you verify a real sending domain.
RESEND_FROM=Catch a Beast <onboarding@resend.dev>

# Email of the account that should be auto-promoted to admin (gains access to
# the moderation queue at /api/admin/reports). Checked at signup and at boot,
# so it works whether the account already exists or signs up later.
ADMIN_EMAIL=

# Cloudflare R2 credentials for durable photo storage (powers Memories — a
# private history of your own posts that survives past the normal 24h feed
# expiry). If any of these are unset, photos just stay on local disk like
# before: fine locally, but Render's disk is wiped on redeploy, so nothing
# will actually be durable until these are set for real.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (r2.dev URL or your own custom domain), no
# trailing slash — e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# Apple Push Notification service (token-based auth via a .p8 key from
# Apple Developer → Certificates, Identifiers & Profiles → Keys). If any of
# these are unset, push notifications are silently disabled — everything
# else keeps working. APNS_KEY is the full contents of the .p8 file; paste
# it with real newlines if your platform supports multi-line env vars
# (Render does), otherwise use \n escapes and it'll be converted back.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Set to true only once shipping a build from the real App Store/TestFlight
# (not a local Xcode debug build, which needs the sandbox APNs environment).
APNS_PRODUCTION=false
